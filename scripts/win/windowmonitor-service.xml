<service>
  <id>WindowMonitor</id>
  <name>Windows Monitor</name>
  <description>Windows Monitor - Monitors active window and uploads screenshots to WebDAV storage.</description>
  <executable>%BASE%\jre\bin\javaw.exe</executable>
  <arguments>-jar "%BASE%\windowMonitor-1.0.0.jar"</arguments>
  <logmode>rotate</logmode>
  <logpath>%BASE%\logs</logpath>
  <icon>%BASE%\windowmonitor.ico</icon>
  <startmode>Automatic</startmode>
  <stopparentprocessfirst>true</stopparentprocessfirst>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="20 sec"/>
  <onfailure action="none"/>
</service>
